	<queryString language="SQL">
		<![CDATA[SELECT siscafe.receipt.id,
	siscafe.customer.id,
	siscafe.customer.customer_id,
	siscafe.customer.prod_id,
	siscafe.customer.prod_name,
	siscafe.customer.type,
	siscafe.customer.quantity,
	siscafe.customer.price,
	siscafe.customer.date,
	siscafe.customer.em_username,
	siscafe.customer.image,
	siscafe.receipt.customer_id,
	siscafe.receipt.total,
	siscafe.receipt.date,
	siscafe.receipt.em_username
FROM siscafe.receipt
	INNER JOIN siscafe.customer ON 
	 siscafe.customer.id = siscafe.receipt.id]]>
	</queryString>
